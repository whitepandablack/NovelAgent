  "cases": [
    {
      "id": "external_nocha_style_near_miss",
      "task": "story_agent_capability",
      "request": {
        "title": "走马灯星球",
        "premise": "星球和地球无限相似，文明整体倒退，远距离光接触会触发退变。",
        "genre": "文明退变科幻",
        "style": "倒序、危险、克制"
      },
      "required": {
        "source_dataset": "NoCha",
        "contract_keys": [
          "timeline_causality",
          "plot_thread_progression"
        ],
        "judge_dimensions": [
          "近似真假陈述区分",
          "长上下文证据引用"
        ],
        "template": {
          "ability": "区分关键词相似但时间和因果不同的剧情陈述。",
          "input": "章节正文、故事状态、true/false 近似陈述。",
          "expected_structure": "必须引用章节或状态证据说明真陈述成立，并解释假陈述错在时间顺序、因果链或角色关系哪里。",
          "failure_example": "只因两个陈述都出现光接触、退变、PT-001 就判为相同。"
        }
      },
      "expected_state_delta": {
        "plot_thread_status": {
          "PT-001": "developed"
        }
      },
      "rubric": {
        "contract_rules": 45,
        "state_delta": 35,
        "text_payoff": 20
      },
      "pass_threshold": 80
    },
