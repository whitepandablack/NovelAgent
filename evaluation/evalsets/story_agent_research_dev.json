    {
      "id": "research_nocha_style_minimal_pair",
      "task": "story_agent_structural_contract",
      "request": {
        "title": "星诊所",
        "premise": "一家诊所会在病历里提前写下尚未发生的症状",
        "genre": "近未来悬疑",
        "style": "克制、细节密集"
      },
      "required": {
        "source_dataset": "NoCha",
        "contract_keys": [
          "character_choice_chain",
          "plot_thread_progression",
          "timeline_causality"
        ],
        "judge_dimensions": [
          "near_miss_fact_discrimination",
          "textual_evidence"
        ],
        "template": {
          "ability": "区分关键词相似但事实、时间或因果不同的真假剧情陈述。",
          "input": "给 Agent 已写章节和一组 true/false 近似陈述。",
          "expected_structure": "报告必须列出支持真实陈述的章节证据，并解释假陈述错在时间、因果或角色关系。",
          "failure_example": "只因为真假陈述都包含 PT-001、记忆、异常等关键词就判为相同。"
        }
      },
      "expected_state_delta": {
        "plot_thread_status": {
          "PT-001": "developed"
        }
      },
      "rubric": {
        "contract_completeness": 60,
        "state_delta": 40
      },
      "pass_threshold": 80
    },
